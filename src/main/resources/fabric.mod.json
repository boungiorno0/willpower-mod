{
  "schemaVersion": 1,
  "id": "willpower",
  "version": "${version}",
  "name": "Willpower Constructs",
  "description": "Фонари Эмоционального Спектра: все 9 корпусов, светящиеся 3D-конструкты, полёт, клятвы и Центральные Батареи.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.example.willpower.WillpowerMod"],
    "client": ["com.example.willpower.client.WillpowerClient"],
    "cardinal-components": ["com.example.willpower.component.ModComponents"]
  },
  "mixins": [
    "willpower.mixins.json"
  ],
  "custom": {
    "cardinal-components": [
      "willpower:lantern"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "cardinal-components-base": ">=6.1.0",
    "cardinal-components-entity": ">=6.1.0"
  }
}
